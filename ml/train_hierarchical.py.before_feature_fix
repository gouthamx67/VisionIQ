import sys, os
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

import pandas as pd
import joblib
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import accuracy_score, classification_report
from sklearn.preprocessing import LabelEncoder

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
FEATURE_PATH = os.path.join(ROOT, "dataset/metadata/feature_dataset.csv")
ARTIFACT_DIR = os.path.join(ROOT, "ml/artifacts")
os.makedirs(ARTIFACT_DIR, exist_ok=True)

EXCLUDED_COLUMNS = ["source_id", "split", "variant_id", "degradation", "severity", "severity_name", "is_degraded"]

df = pd.read_csv(FEATURE_PATH)
features = [c for c in df.columns if c not in EXCLUDED_COLUMNS]
X = df[features]
y_degraded = df["is_degraded"]
y_type = df["degradation"]

train_mask = df["split"] == "train"
val_mask = df["split"] == "val"
test_mask = df["split"] == "test"

# Stage 1: Clean vs Degraded
le_stage1 = LabelEncoder()
y_stage1 = le_stage1.fit_transform(y_degraded)
# Fixed: Added class_weight="balanced" to help the model detect the few clean images
clf_stage1 = RandomForestClassifier(n_estimators=1000, class_weight="balanced_subsample", max_features="sqrt", min_samples_leaf=1, random_state=42, n_jobs=-1)
clf_stage1.fit(X[train_mask], y_stage1[train_mask])
pred_stage1 = clf_stage1.predict(X[test_mask])
print("STAGE 1 (Clean vs Degraded) Test Results")
print("Accuracy:", accuracy_score(y_stage1[test_mask], pred_stage1))
target_names_stage1 = ["Clean", "Degraded"] if set(le_stage1.classes_) == {0, 1} else [str(x) for x in le_stage1.classes_]
print(classification_report(y_stage1[test_mask], pred_stage1, target_names=target_names_stage1))

# Stage 2: Degradation Type (only on degraded images)
# Fixed: Properly subset the data so X and y have matching lengths
degraded_indices = df[df["is_degraded"] == 1].index
X_deg = X.loc[degraded_indices]
y_deg = df.loc[degraded_indices, "degradation"]
train_deg_mask = (df.loc[degraded_indices, "split"] == "train")
test_deg_mask = (df.loc[degraded_indices, "split"] == "test")

le_stage2 = LabelEncoder()
y_stage2 = le_stage2.fit_transform(y_deg)
clf_stage2 = RandomForestClassifier(n_estimators=1000, class_weight="balanced_subsample", max_features="sqrt", min_samples_leaf=1, random_state=42, n_jobs=-1)
clf_stage2.fit(X_deg[train_deg_mask], y_stage2[train_deg_mask])
pred_stage2 = clf_stage2.predict(X_deg[test_deg_mask])
print("\nSTAGE 2 (Degradation Type) Test Results")
print("Accuracy:", accuracy_score(y_stage2[test_deg_mask], pred_stage2))
target_names_stage2 = [str(x) for x in le_stage2.classes_]
print(classification_report(y_stage2[test_deg_mask], pred_stage2, target_names=target_names_stage2))

# Save models
joblib.dump(clf_stage1, os.path.join(ARTIFACT_DIR, "stage1_clean_vs_degraded.joblib"))
joblib.dump(le_stage1, os.path.join(ARTIFACT_DIR, "stage1_label_encoder.joblib"))
joblib.dump(clf_stage2, os.path.join(ARTIFACT_DIR, "stage2_degradation_type.joblib"))
joblib.dump(le_stage2, os.path.join(ARTIFACT_DIR, "stage2_label_encoder.joblib"))
print("\nSaved hierarchical models to ml/artifacts/")
